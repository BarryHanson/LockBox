DATABASE_URL="postgresql://user:password@localhost:5432/lockboxdb"
JWT_SECRET="your-generated-secret-here-run-openssl-rand-base64-32"

# Cloudflare R2 configuration (S3-compatible)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_PRO_PRICE_ID=price_your-pro-price-id
STRIPE_TEAM_PRICE_ID=price_your-team-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET="your-generated-secret-here-run-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Cloudflare Turnstile (required for login/signup captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# SMTP Configuration for 2FA Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-email@yourdomain.com
