# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip
*.bak
*.orig

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# local runtime data
log.txt
audit.txt
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# browser extension build artifacts
browser-extension/**/*.zip
browser-extension/**/node_modules/
browser-extension/**/dist/
browser-extension/**/build/

# desktop / csharp build outputs
**/bin/
**/obj/
**/publish/
**/artifacts/
**/*.user
**/*.suo
**/*.cache

# generated project artifacts
bytelock-extension.zip
*.dll
*.exe
*.appx
